/* ==========================================================================
   LeadScan K2 - Dark Theme Stylesheet
   3D Scanner Application
   ========================================================================== */

/* --------------------------------------------------------------------------
   1. Global & QMainWindow
   -------------------------------------------------------------------------- */
QMainWindow {
    background-color: #000000;
    border: none;
}

QWidget {
    font-family: "Microsoft YaHei", "Segoe UI", "Arial", sans-serif;
    color: #FFFFFF;
    selection-background-color: #900021;
    selection-color: #FFFFFF;
}

QLabel {
    color: #FFFFFF;
    background: transparent;
    border: none;
}

/* --------------------------------------------------------------------------
    2. Title Bar  (QWidget#titleBar)
    -------------------------------------------------------------------------- */
QWidget#titleBar {
    background-color: #900021;
    min-height: 36px;
    max-height: 36px;
    border-bottom: 1px solid #a30020;
}

QWidget#titleBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 0px;
    min-width: 28px;
    max-width: 28px;
    min-height: 28px;
    max-height: 28px;
    padding: 0px;
    qproperty-flat: true;
}

QWidget#titleBar QPushButton:hover {
    background: rgba(255, 255, 255, 40);
}

QWidget#titleBar QPushButton:pressed {
    background: rgba(255, 255, 255, 80);
}

QWidget#titleBar QPushButton#btnMinimize,
QWidget#titleBar QPushButton#btnMaximize,
QWidget#titleBar QPushButton#btnClose {
    min-width: 40px;
    max-width: 40px;
    min-height: 36px;
    max-height: 36px;
    border-radius: 0px;
}

QWidget#titleBar QPushButton#btnClose:hover {
    background: #e81123;
}

QWidget#titleBar QLabel#projectName {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: normal;
    padding-left: 8px;
    background: transparent;
}

/* --------------------------------------------------------------------------
   3. Navigation Bar  (QWidget#navBar)
   -------------------------------------------------------------------------- */
QWidget#navBar {
    background-color: #900021;
    min-height: 38px;
    max-height: 38px;
    border: none;
}

QWidget#navBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 4px;
    color: #FFFFFF;
    font-size: 12px;
    padding: 0px 8px;
    min-height: 28px;
    outline: none;
}

QWidget#navBar QLabel {
    border: none;
    background: transparent;
}

QWidget#navBar > QWidget {
    border: none;
    background: transparent;
}

QWidget#navBar QPushButton:hover {
    background: rgba(255, 255, 255, 50);
}

QWidget#navBar QPushButton:pressed {
    background: rgba(255, 255, 255, 90);
}

QWidget#navBar QPushButton:checked,
QWidget#navBar QPushButton#navActive,
QWidget#navBar QPushButton[active="true"] {
    background-color: #FFFFFF;
    color: #000000;
    border-radius: 4px;
    font-weight: bold;
}

QWidget#navBar QPushButton:checked:hover {
    background-color: #e0e0e0;
}

/* Left group - scan mode buttons (5 buttons, each 84px) */
QWidget#navBarLeft QPushButton,
QWidget#navBar QWidget#navLeftGroup QPushButton {
    min-width: 84px;
    max-width: 84px;
    font-size: 12px;
}

/* Right group - scan mode buttons */
QWidget#navBarRight QPushButton,
QWidget#navBar QWidget#navRightGroup QPushButton {
    min-width: 84px;
    max-width: 84px;
    font-size: 12px;
}

QWidget#navBar QLabel#scanModeText {
    color: #FFFFFF;
    font-size: 12px;
    background: transparent;
    border: none;
}

QWidget#navBar QPushButton#scanModeButton:checked QLabel#scanModeText,
QWidget#navBar QPushButton#scanModeButton[active="true"] QLabel#scanModeText {
    color: #000000;
}

/* --------------------------------------------------------------------------
   4. Toolbar  (QWidget#toolBar)
   -------------------------------------------------------------------------- */
QWidget#toolBar {
    background-color: #e0e0e0;
    min-height: 56px;
    max-height: 56px;
    border: none;
    border-right: 1px solid #d0d0d0;
}

QWidget#toolBar QPushButton {
    background: transparent;
    border: none;
    border-radius: 0px;
    color: #FFFFFF;
    font-size: 10px;
    min-width: 64px;
    max-width: 64px;
    min-height: 56px;
    max-height: 56px;
    padding: 4px 0px;
    icon-size: 20px 20px;
    qproperty-flat: true;
}

QWidget#toolBar QPushButton:hover {
    background: rgba(255, 255, 255, 25);
}

QWidget#toolBar QPushButton:pressed {
    background: rgba(255, 255, 255, 50);
}

QWidget#toolBar QPushButton:checked,
QWidget#toolBar QPushButton#toolActive,
QWidget#toolBar QPushButton[active="true"] {
    border-bottom: 2px solid #900021;
    background: rgba(255, 255, 255, 15);
}

QWidget#toolBar QPushButton:checked:hover {
    background: rgba(255, 255, 255, 35);
}

/* --------------------------------------------------------------------------
   5. Left Panel  (QWidget#leftPanel)
   -------------------------------------------------------------------------- */
QWidget#leftPanel {
    background-color: #ffffff;
    min-width: 240px;
    max-width: 240px;
    border: none;
}

/* Section Headers */
QWidget#leftPanel QLabel#sectionHeader,
QWidget#leftPanel QPushButton#sectionHeader {
    min-height: 28px;
    max-height: 28px;
    font-size: 12px;
    font-weight: bold;
    color: #FFFFFF;
    background: transparent;
    border: none;
    padding-left: 8px;
    text-align: left;
}

QWidget#leftPanel QPushButton#sectionHeader:hover {
    background: rgba(255, 255, 255, 20);
}

/* Tree View / List Items */
QWidget#leftPanel QTreeWidget,
QWidget#leftPanel QTreeView,
QWidget#leftPanel QListView,
QWidget#leftPanel QListWidget {
    background-color: #1a1a1a;
    color: #FFFFFF;
    border: none;
    outline: none;
    font-size: 12px;
}

QWidget#leftPanel QTreeWidget::item,
QWidget#leftPanel QTreeView::item,
QWidget#leftPanel QListView::item,
QWidget#leftPanel QListWidget::item {
    min-height: 25px;
    height: 25px;
    padding-left: 8px;
    border: none;
    color: #FFFFFF;
}

QWidget#leftPanel QTreeWidget::item:hover,
QWidget#leftPanel QTreeView::item:hover,
QWidget#leftPanel QListView::item:hover,
QWidget#leftPanel QListWidget::item:hover {
    background: rgba(255, 255, 255, 30);
}

QWidget#leftPanel QTreeWidget::item:selected,
QWidget#leftPanel QTreeView::item:selected,
QWidget#leftPanel QListView::item:selected,
QWidget#leftPanel QListWidget::item:selected {
    background: #900021;
    color: #FFFFFF;
}

QWidget#leftPanel QTreeWidget::branch,
QWidget#leftPanel QTreeView::branch {
    background-color: #1a1a1a;
}

/* Sliders in left panel */
QWidget#leftPanel QSlider::groove:horizontal {
    height: 4px;
    background: #333333;
    border-radius: 2px;
}

QWidget#leftPanel QSlider::handle:horizontal {
    background: #900021;
    width: 14px;
    height: 14px;
    margin: -4px 0px;
    border-radius: 7px;
    border: none;
}

QWidget#leftPanel QSlider::handle:horizontal:hover {
    background: #b30029;
}

QWidget#leftPanel QSlider::sub-page:horizontal {
    background: #900021;
    border-radius: 2px;
}

/* Input Fields */
QWidget#leftPanel QLineEdit {
    min-height: 20px;
    max-height: 20px;
    min-width: 48px;
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 2px;
    padding: 0px 4px;
    font-size: 12px;
    selection-background-color: #900021;
}

QWidget#leftPanel QLineEdit:focus {
    border: 1px solid #900021;
}

QWidget#leftPanel QSpinBox,
QWidget#leftPanel QDoubleSpinBox {
    min-height: 20px;
    max-height: 20px;
    min-width: 48px;
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 2px;
    padding: 0px 4px;
    font-size: 12px;
}

QWidget#leftPanel QSpinBox:focus,
QWidget#leftPanel QDoubleSpinBox:focus {
    border: 1px solid #900021;
}

QWidget#leftPanel QSpinBox::up-button,
QWidget#leftPanel QDoubleSpinBox::up-button {
    background: #333333;
    border: none;
    width: 16px;
}

QWidget#leftPanel QSpinBox::down-button,
QWidget#leftPanel QDoubleSpinBox::down-button {
    background: #333333;
    border: none;
    width: 16px;
}

QWidget#leftPanel QSpinBox::up-button:hover,
QWidget#leftPanel QDoubleSpinBox::up-button:hover,
QWidget#leftPanel QSpinBox::down-button:hover,
QWidget#leftPanel QDoubleSpinBox::down-button:hover {
    background: #444444;
}

/* Tab Buttons (自由/推荐/定义) */
QWidget#leftPanel QPushButton#tabFree,
QWidget#leftPanel QPushButton#tabRecommend,
QWidget#leftPanel QPushButton#tabDefine,
QWidget#leftPanel QPushButton[class="tabButton"] {
    min-width: 80px;
    max-width: 80px;
    min-height: 28px;
    max-height: 28px;
    background-color: #2a2a2a;
    color: #999999;
    border: none;
    border-radius: 4px;
    font-size: 12px;
    padding: 0px;
}

QWidget#leftPanel QPushButton#tabFree:hover,
QWidget#leftPanel QPushButton#tabRecommend:hover,
QWidget#leftPanel QPushButton#tabDefine:hover,
QWidget#leftPanel QPushButton[class="tabButton"]:hover {
    background-color: #3a3a3a;
    color: #FFFFFF;
}

QWidget#leftPanel QPushButton#tabFree:checked,
QWidget#leftPanel QPushButton#tabRecommend:checked,
QWidget#leftPanel QPushButton#tabDefine:checked,
QWidget#leftPanel QPushButton[class="tabButton"]:checked,
QWidget#leftPanel QPushButton#tabFree[active="true"],
QWidget#leftPanel QPushButton#tabRecommend[active="true"],
QWidget#leftPanel QPushButton#tabDefine[active="true"],
QWidget#leftPanel QPushButton[class="tabButton"][active="true"] {
    background-color: #900021;
    color: #FFFFFF;
    font-weight: bold;
}

/* Comboboxes */
QWidget#leftPanel QComboBox {
    min-height: 20px;
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 2px;
    padding: 0px 4px;
    font-size: 12px;
}

QWidget#leftPanel QComboBox:hover {
    border: 1px solid #555555;
}

QWidget#leftPanel QComboBox::drop-down {
    border: none;
    width: 16px;
}

QWidget#leftPanel QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    selection-background-color: #900021;
    outline: none;
}

/* Group boxes */
QWidget#leftPanel QGroupBox {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    border: none;
    border-top: 1px solid #333333;
    margin-top: 8px;
    padding-top: 12px;
}

QWidget#leftPanel QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 4px;
    color: #FFFFFF;
}

/* Checkboxes */
QWidget#leftPanel QCheckBox {
    color: #FFFFFF;
    font-size: 12px;
    spacing: 6px;
}

QWidget#leftPanel QCheckBox::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 2px;
    background: #2a2a2a;
}

QWidget#leftPanel QCheckBox::indicator:checked {
    background: #900021;
    border: 1px solid #900021;
}

QWidget#leftPanel QCheckBox::indicator:hover {
    border: 1px solid #888888;
}

/* --------------------------------------------------------------------------
   6. Info Panel Grid Cards
   -------------------------------------------------------------------------- */
QFrame#infoCard,
QWidget#infoCard {
    background-color: #FFFFFF;
    border-radius: 4px;
    border: 1px solid #C0C0C0;
}

QFrame#infoCard QLabel#cardLabel,
QWidget#infoCard QLabel#cardLabel {
    font-size: 11px;
    color: #000000;
    background: transparent;
    border: none;
}

QFrame#infoCard QLabel#cardValue,
QWidget#infoCard QLabel#cardValue {
    font-size: 12px;
    color: #000000;
    font-weight: bold;
    background: transparent;
    border: none;
}

/* --------------------------------------------------------------------------
    7. 3D View Area
    -------------------------------------------------------------------------- */
QWidget#view3d,
QWidget#glWidget,
QWidget#viewport {
    background-color: #f0f0f0;
    border: none;
}

QOpenGLWidget {
    background-color: #f0f0f0;
    border: none;
}

/* --------------------------------------------------------------------------
    8. Bottom Toolbar  (QWidget#bottomToolBar)
    -------------------------------------------------------------------------- */
QWidget#bottomToolBar {
    background-color: #e0e0e0;
    min-height: 47px;
    max-height: 47px;
    border: none;
    border-top: 1px solid #d0d0d0;
}

QWidget#bottomToolBar QWidget#bottomContainer {
    background: transparent;
    border: none;
}

QWidget#bottomToolBar QPushButton {
    min-width: 44px;
    max-width: 44px;
    min-height: 32px;
    max-height: 32px;
    background: transparent;
    border: 1px solid transparent;
    border-radius: 4px;
    qproperty-flat: true;
    icon-size: 20px 20px;
    padding: 2px;
}

QWidget#bottomToolBar QPushButton:hover {
    background: rgba(255, 255, 255, 30);
    border: 1px solid rgba(255, 255, 255, 40);
}

QWidget#bottomToolBar QPushButton:pressed {
    background: rgba(255, 255, 255, 60);
}

QWidget#bottomToolBar QPushButton:checked,
QWidget#bottomToolBar QPushButton[active="true"] {
    background-color: #900021;
    color: #FFFFFF;
    border: 1px solid #900021;
}

QWidget#bottomToolBar QPushButton:checked:hover {
    background-color: #b30029;
}

/* --------------------------------------------------------------------------
   9. Color Gradient Bar
   -------------------------------------------------------------------------- */
QWidget#colorGradientBar {
    background: transparent;
    border: none;
}

/* --------------------------------------------------------------------------
   10. Coordinate Display (bottom-left of 3D view)
   -------------------------------------------------------------------------- */
QLabel#coordDisplay,
QWidget#coordDisplay {
    background-color: rgba(0, 0, 0, 180);
    color: #FFFFFF;
    font-size: 11px;
    font-family: "Consolas", "Courier New", monospace;
    padding: 4px 8px;
    border-radius: 4px;
    border: none;
}

QLabel#coordDisplay QLabel,
QWidget#coordDisplay QLabel {
    color: #FFFFFF;
    font-size: 11px;
    background: transparent;
}

/* --------------------------------------------------------------------------
   11. Scrollbars
   -------------------------------------------------------------------------- */
QScrollBar:vertical {
    background: #1a1a1a;
    width: 6px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:vertical {
    background: #555555;
    min-height: 30px;
    border-radius: 3px;
}

QScrollBar::handle:vertical:hover {
    background: #777777;
}

QScrollBar::handle:vertical:pressed {
    background: #999999;
}

QScrollBar::add-line:vertical,
QScrollBar::sub-line:vertical {
    height: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:vertical,
QScrollBar::sub-page:vertical {
    background: none;
}

QScrollBar:horizontal {
    background: #1a1a1a;
    height: 6px;
    margin: 0px;
    border: none;
}

QScrollBar::handle:horizontal {
    background: #555555;
    min-width: 30px;
    border-radius: 3px;
}

QScrollBar::handle:horizontal:hover {
    background: #777777;
}

QScrollBar::handle:horizontal:pressed {
    background: #999999;
}

QScrollBar::add-line:horizontal,
QScrollBar::sub-line:horizontal {
    width: 0px;
    background: none;
    border: none;
}

QScrollBar::add-page:horizontal,
QScrollBar::sub-page:horizontal {
    background: none;
}

/* --------------------------------------------------------------------------
   12. QSlider (Global)
   -------------------------------------------------------------------------- */
QSlider::groove:horizontal {
    height: 4px;
    background: #333333;
    border-radius: 2px;
}

QSlider::handle:horizontal {
    background: #900021;
    width: 14px;
    height: 14px;
    margin: -5px 0px;
    border-radius: 7px;
    border: none;
}

QSlider::handle:horizontal:hover {
    background: #b30029;
}

QSlider::handle:horizontal:pressed {
    background: #cc0033;
}

QSlider::sub-page:horizontal {
    background: #900021;
    border-radius: 2px;
}

QSlider::groove:vertical {
    width: 4px;
    background: #333333;
    border-radius: 2px;
}

QSlider::handle:vertical {
    background: #900021;
    width: 14px;
    height: 14px;
    margin: 0px -5px;
    border-radius: 7px;
}

QSlider::handle:vertical:hover {
    background: #b30029;
}

QSlider::sub-page:vertical {
    background: #900021;
    border-radius: 2px;
}

/* --------------------------------------------------------------------------
   13. Tooltips
   -------------------------------------------------------------------------- */
QToolTip {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #555555;
    border-radius: 4px;
    padding: 6px 8px;
    font-size: 12px;
}

/* --------------------------------------------------------------------------
   14. General QPushButton Hover
   -------------------------------------------------------------------------- */
QPushButton {
    background: transparent;
    border: none;
    color: #FFFFFF;
    border-radius: 4px;
    padding: 4px 8px;
}

QPushButton:hover {
    background: rgba(255, 255, 255, 25);
}

/* --------------------------------------------------------------------------
   15. General QPushButton Pressed
   -------------------------------------------------------------------------- */
QPushButton:pressed {
    background: rgba(0, 0, 0, 80);
}

QPushButton:disabled {
    color: #555555;
}

QPushButton:focus {
    outline: none;
    border: none;
}

/* --------------------------------------------------------------------------
   General QMenu
   -------------------------------------------------------------------------- */
QMenu {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 0px;
}

QMenu::item {
    padding: 6px 24px;
    font-size: 12px;
}

QMenu::item:selected {
    background-color: #900021;
    border-radius: 2px;
}

QMenu::item:disabled {
    color: #555555;
}

QMenu::separator {
    height: 1px;
    background: #333333;
    margin: 4px 8px;
}

QMenu::indicator {
    width: 14px;
    height: 14px;
    margin-left: 4px;
}

/* --------------------------------------------------------------------------
   General QTabWidget / QTabBar
   -------------------------------------------------------------------------- */
QTabWidget::pane {
    background-color: #1a1a1a;
    border: none;
    border-top: 1px solid #333333;
}

QTabBar::tab {
    background: transparent;
    color: #999999;
    border: none;
    padding: 8px 16px;
    font-size: 12px;
}

QTabBar::tab:hover {
    color: #FFFFFF;
    background: rgba(255, 255, 255, 15);
}

QTabBar::tab:selected {
    color: #FFFFFF;
    border-bottom: 2px solid #900021;
}

/* --------------------------------------------------------------------------
   General QProgressBar
   -------------------------------------------------------------------------- */
QProgressBar {
    background-color: #333333;
    border: none;
    border-radius: 2px;
    height: 4px;
    text-align: center;
    color: transparent;
}

QProgressBar::chunk {
    background-color: #900021;
    border-radius: 2px;
}

/* --------------------------------------------------------------------------
   General QDialog
   -------------------------------------------------------------------------- */
QDialog {
    background-color: #1a1a1a;
    color: #FFFFFF;
}

/* --------------------------------------------------------------------------
   QGroupBox (Global)
   -------------------------------------------------------------------------- */
QGroupBox {
    color: #FFFFFF;
    font-size: 12px;
    font-weight: bold;
    border: 1px solid #333333;
    border-radius: 4px;
    margin-top: 12px;
    padding-top: 16px;
}

QGroupBox::title {
    subcontrol-origin: margin;
    subcontrol-position: top left;
    padding: 0px 6px;
    color: #FFFFFF;
}

/* --------------------------------------------------------------------------
   QComboBox (Global)
   -------------------------------------------------------------------------- */
QComboBox {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    font-size: 12px;
}

QComboBox:hover {
    border: 1px solid #555555;
}

QComboBox::drop-down {
    border: none;
    width: 20px;
}

QComboBox::down-arrow {
    image: none;
    border-left: 4px solid transparent;
    border-right: 4px solid transparent;
    border-top: 5px solid #999999;
}

QComboBox QAbstractItemView {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    selection-background-color: #900021;
    outline: none;
    border-radius: 4px;
}

/* --------------------------------------------------------------------------
   QLineEdit (Global)
   -------------------------------------------------------------------------- */
QLineEdit {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 4px 8px;
    min-height: 24px;
    font-size: 12px;
    selection-background-color: #900021;
}

QLineEdit:hover {
    border: 1px solid #555555;
}

QLineEdit:focus {
    border: 1px solid #900021;
}

/* --------------------------------------------------------------------------
   QTextEdit / QPlainTextEdit
   -------------------------------------------------------------------------- */
QTextEdit,
QPlainTextEdit {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    font-size: 12px;
    selection-background-color: #900021;
}

/* --------------------------------------------------------------------------
   QCheckBox (Global)
   -------------------------------------------------------------------------- */
QCheckBox {
    color: #FFFFFF;
    font-size: 12px;
    spacing: 6px;
}

QCheckBox::indicator {
    width: 16px;
    height: 16px;
    border: 1px solid #555555;
    border-radius: 3px;
    background: #2a2a2a;
}

QCheckBox::indicator:checked {
    background: #900021;
    border: 1px solid #900021;
}

QCheckBox::indicator:hover {
    border: 1px solid #888888;
}

QCheckBox::indicator:disabled {
    background: #1a1a1a;
    border: 1px solid #333333;
}

/* --------------------------------------------------------------------------
   QRadioButton
   -------------------------------------------------------------------------- */
QRadioButton {
    color: #FFFFFF;
    font-size: 12px;
    spacing: 6px;
}

QRadioButton::indicator {
    width: 14px;
    height: 14px;
    border: 1px solid #555555;
    border-radius: 7px;
    background: #2a2a2a;
}

QRadioButton::indicator:checked {
    background: #900021;
    border: 2px solid #900021;
}

QRadioButton::indicator:hover {
    border: 1px solid #888888;
}

/* --------------------------------------------------------------------------
   QSpinBox / QDoubleSpinBox (Global)
   -------------------------------------------------------------------------- */
QSpinBox,
QDoubleSpinBox {
    background-color: #2a2a2a;
    color: #FFFFFF;
    border: 1px solid #333333;
    border-radius: 4px;
    padding: 2px 8px;
    min-height: 24px;
    font-size: 12px;
}

QSpinBox:focus,
QDoubleSpinBox:focus {
    border: 1px solid #900021;
}

QSpinBox::up-button,
QDoubleSpinBox::up-button {
    subcontrol-origin: border;
    subcontrol-position: top right;
    width: 16px;
    border-left: 1px solid #333333;
    background: #333333;
}

QSpinBox::down-button,
QDoubleSpinBox::down-button {
    subcontrol-origin: border;
    subcontrol-position: bottom right;
    width: 16px;
    border-left: 1px solid #333333;
    background: #333333;
}

QSpinBox::up-button:hover,
QDoubleSpinBox::up-button:hover,
QSpinBox::down-button:hover,
QDoubleSpinBox::down-button:hover {
    background: #444444;
}

QSpinBox::up-arrow,
QDoubleSpinBox::up-arrow {
    width: 6px;
    height: 6px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-bottom: 4px solid #999999;
}

QSpinBox::down-arrow,
QDoubleSpinBox::down-arrow {
    width: 6px;
    height: 6px;
    border-left: 3px solid transparent;
    border-right: 3px solid transparent;
    border-top: 4px solid #999999;
}

/* --------------------------------------------------------------------------
   QSplitter Handle
   -------------------------------------------------------------------------- */
QSplitter::handle {
    background: #333333;
}

QSplitter::handle:horizontal {
    width: 1px;
}

QSplitter::handle:vertical {
    height: 1px;
}

QSplitter::handle:hover {
    background: #900021;
}

/* --------------------------------------------------------------------------
   QDockWidget
   -------------------------------------------------------------------------- */
QDockWidget {
    color: #FFFFFF;
    font-size: 12px;
    titlebar-close-icon: none;
}

QDockWidget::title {
    background: #1a1a1a;
    padding: 6px;
    border-bottom: 1px solid #333333;
    text-align: left;
}

QDockWidget::close-button,
QDockWidget::float-button {
    background: transparent;
    border: none;
    padding: 2px;
}

QDockWidget::close-button:hover,
QDockWidget::float-button:hover {
    background: rgba(255, 255, 255, 30);
    border-radius: 2px;
}

/* --------------------------------------------------------------------------
   Status Indicators
   -------------------------------------------------------------------------- */
QLabel#statusLabel {
    color: #999999;
    font-size: 11px;
}

QLabel#statusConnected {
    color: #00cc66;
    font-size: 11px;
}

QLabel#statusDisconnected {
    color: #ff4444;
    font-size: 11px;
}

QLabel#statusWarning {
    color: #ffaa00;
    font-size: 11px;
}

/* --------------------------------------------------------------------------
   Panel Dividers / Separators
   -------------------------------------------------------------------------- */
QFrame#hSeparator {
    background: #333333;
    max-height: 1px;
    border: none;
}

QFrame#vSeparator {
    background: #333333;
    max-width: 1px;
    border: none;
}

/* --------------------------------------------------------------------------
   Disabled State Overrides
   -------------------------------------------------------------------------- */
QWidget:disabled {
    color: #555555;
}

QPushButton:disabled {
    color: #555555;
    background: transparent;
}

QLabel:disabled {
    color: #555555;
}

QLineEdit:disabled {
    background-color: #1a1a1a;
    color: #555555;
}

QComboBox:disabled {
    background-color: #1a1a1a;
    color: #555555;
}
